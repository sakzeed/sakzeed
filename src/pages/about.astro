---
import Base from '../layouts/Base.astro';
import { SITE } from '../config';
---

<Base title="เกี่ยวกับ" description={`ประวัติและทักษะของ ${SITE.name}`}>
  <div class="prose">
    <h1>เกี่ยวกับผม</h1>
    <p>
      <!-- แก้ย่อหน้านี้: เล่าสั้นๆ ว่าคุณเป็นใคร ทำงานด้านไหน และช่วยลูกค้าแก้ปัญหาอะไรได้ -->
      ผมชื่อ{SITE.name} ทำงานด้าน{SITE.role} ชอบทำงานที่ช่วยให้ธุรกิจเล็กๆ ใช้เทคโนโลยีได้ง่ายขึ้น
      เน้นงานที่ส่งมอบแล้วลูกค้าดูแลต่อเองได้
    </p>

    <h2>ทักษะ</h2>
    <p>
      <span class="tag">HTML / CSS</span>
      <span class="tag">JavaScript</span>
      <span class="tag">Python</span>
      <span class="tag">ออกแบบ UI</span>
    </p>

    <h2>ประสบการณ์</h2>
    <ul>
      <li><strong>ปี 2025 – ปัจจุบัน</strong> · ฟรีแลนซ์ รับทำเว็บไซต์และระบบเล็ก</li>
      <li><strong>ปี 2023 – 2025</strong> · ตำแหน่งงานเดิม ที่บริษัท/องค์กร</li>
    </ul>

    <h2>วิธีทำงานกับผม</h2>
    <ol>
      <li>คุยรายละเอียดงานและงบประมาณ (ฟรี)</li>
      <li>เสนอแผนงาน ราคา และระยะเวลา</li>
      <li>ทำงานพร้อมอัปเดตความคืบหน้าเป็นระยะ</li>
      <li>ส่งมอบ พร้อมสอนวิธีดูแลต่อ</li>
    </ol>

    <p><a class="btn" href="/contact/">คุยงานกับผม</a></p>
  </div>
</Base>
